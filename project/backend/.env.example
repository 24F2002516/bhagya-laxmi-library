# Django General Configuration
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL 18)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.hbdpzgykpuqdpwbmgcws:KGqcgPRlyP1IzDCT@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Business Constants (Bhagya Laxmi Library)
TOTAL_LIBRARY_SEATS=150
SEAT_MONTHLY_FEE=800
GRACE_PERIOD_HOURS=48
RENEWAL_REMINDER_DAYS=4,3
SEAT_HOLD_DURATION_MINUTES=30


# Admin Seed Credentials
ADMIN_EMAIL=owner@bhagyalaxmilibrary.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
ADMIN_PHONE_NUMBER=9999999999

# Email / SMTP Configuration
# For Gmail SMTP: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True
# Note: Use a 16-character App Password if 2-Step Verification is enabled.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-library-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Bhagya Laxmi Library <your-library-email@gmail.com>

# Google OAuth 2.0 Configuration
# Obtain credentials from https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:8000/accounts/google/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=

# Static & Media Files
STATIC_URL=/static/
MEDIA_URL=/media/
